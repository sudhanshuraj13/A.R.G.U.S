# ═══════════════════════════════════════════
# ARGUS Environment Variables
# ═══════════════════════════════════════════

# NVIDIA NIM API Key (required)
# Get your free key from: https://build.nvidia.com/
KIMI_API_KEY=your_nvidia_nim_api_key_here

# ESP32-CAM URL (required for Raspberry Pi headless mode)
# Set this to the IP address of your ESP32-CAM on the local network.
# Find the IP from the Arduino Serial Monitor after flashing the CameraWebServer sketch.
# Leave blank or remove this line when running on laptop with a local webcam.
ESP32_CAM_URL=http://192.168.1.100
