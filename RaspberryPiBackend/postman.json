{
	"info": {
		"name": "ARGUS Raspberry Pi Backend",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000"
		}
	],
	"item": [
		{
			"name": "Health",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health",
					"host": ["{{base_url}}"],
					"path": ["health"]
				}
			}
		},
		{
			"name": "Detect Object",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "image/jpeg"
					}
				],
				"body": {
					"mode": "file",
					"file": {
						"src": ""
					}
				},
				"url": {
					"raw": "{{base_url}}/detect/object",
					"host": ["{{base_url}}"],
					"path": ["detect", "object"]
				}
			}
		},
		{
			"name": "Detect Currency",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "image/jpeg"
					}
				],
				"body": {
					"mode": "file",
					"file": {
						"src": ""
					}
				},
				"url": {
					"raw": "{{base_url}}/detect/currency",
					"host": ["{{base_url}}"],
					"path": ["detect", "currency"]
				}
			}
		},
		{
			"name": "Assist",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "image/jpeg"
					}
				],
				"body": {
					"mode": "file",
					"file": {
						"src": ""
					}
				},
				"url": {
					"raw": "{{base_url}}/assist",
					"host": ["{{base_url}}"],
					"path": ["assist"]
				}
			}
		},
		{
			"name": "Distance",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"distance\": 45\n}"
				},
				"url": {
					"raw": "{{base_url}}/distance",
					"host": ["{{base_url}}"],
					"path": ["distance"]
				}
			}
		},
		{
			"name": "Submit Voice Command",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"command\": \"Search for latest AI news on Google\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/voice/command",
					"host": ["{{base_url}}"],
					"path": ["voice", "command"]
				}
			}
		},
		{
			"name": "Get Pending Voice Command",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/voice/pending",
					"host": ["{{base_url}}"],
					"path": ["voice", "pending"]
				}
			}
		},
		{
			"name": "Submit Voice Result",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"task_id\": \"REPLACE_WITH_TASK_ID\",\n  \"ok\": true,\n  \"result\": \"Navigated to Google and retrieved search results.\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/voice/result",
					"host": ["{{base_url}}"],
					"path": ["voice", "result"]
				}
			}
		},
		{
			"name": "Get Voice Task Status",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/voice/status/REPLACE_WITH_TASK_ID",
					"host": ["{{base_url}}"],
					"path": ["voice", "status", "REPLACE_WITH_TASK_ID"]
				}
			}
		},
		{
			"name": "AI Assistant Query",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"query\": \"What time is it?\",\n  \"speak_response\": true\n}"
				},
				"url": {
					"raw": "{{base_url}}/ai/query",
					"host": ["{{base_url}}"],
					"path": ["ai", "query"]
				}
			}
		},
		{
			"name": "AI Scene Description",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{base_url}}/ai/scene",
					"host": ["{{base_url}}"],
					"path": ["ai", "scene"]
				}
			}
		},
		{
			"name": "AI Add Note",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"text\": \"Remember to buy medicines\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/ai/notes",
					"host": ["{{base_url}}"],
					"path": ["ai", "notes"]
				}
			}
		},
		{
			"name": "AI Get Notes",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/ai/notes",
					"host": ["{{base_url}}"],
					"path": ["ai", "notes"]
				}
			}
		}
	]
}
