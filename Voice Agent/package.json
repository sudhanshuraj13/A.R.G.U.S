{
  "name": "argus",
  "version": "0.1.2",
  "private": true,
  "description": "ARGUS voice-first AI browser automation assistant",
  "type": "module",
  "manifest": {
    "name": "ARGUS",
    "description": "Voice-first AI browser automation assistant.",
    "permissions": [
      "activeTab",
      "scripting",
      "storage",
      "tabs",
      "sidePanel"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "action": {
      "default_title": "ARGUS"
    },
    "side_panel": {
      "default_path": "sidepanel.html"
    }
  },
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@langchain/langgraph": "^0.2.45",
    "agentql": "^1.6.0",
    "framer-motion": "^11.18.2",
    "plasmo": "^0.90.5",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
